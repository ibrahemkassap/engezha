# ====================================================================
# ENGEZHA (انجزها) - Environment Configuration Template
# ====================================================================

# Next.js Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------------
# Supabase Configuration
# --------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for administrative actions, signed URLs for private uploads, and secure queues
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage Bucket for customer attachments (Images, Docs, Audio)
# This bucket MUST be set to PRIVATE in Supabase Storage settings
SUPABASE_STORAGE_BUCKET=inquiry-attachments

# --------------------------------------------------------------------
# Email Notification Configuration (Nodemailer SMTP)
# --------------------------------------------------------------------
# Primary notification recipient as requested by business:
# ibrahem.kassap@gmail.com
NOTIFICATION_EMAIL_RECIPIENT=ibrahem.kassap@gmail.com

# SMTP Server details
# For Gmail: host = smtp.gmail.com, port = 465 (secure=true) or 587 (secure=false)
# Note: For Gmail, create an "App Password" in Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ibrahem.kassap@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="منصة انجزها" <ibrahem.kassap@gmail.com>

# --------------------------------------------------------------------
# File Upload Limits (Configurable)
# --------------------------------------------------------------------
# Maximum size in bytes per file (Default: 20MB = 20971520 bytes)
MAX_FILE_SIZE_BYTES=20971520
# Maximum total attachments per inquiry
MAX_ATTACHMENTS_COUNT=5
